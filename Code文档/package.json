{
  "name": "ungradu-edu-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next-build.mjs && next build",
    "cloudbase:check": "node scripts/check-cloudbase-connection.mjs",
    "m5:cloudbase:collections": "node scripts/check-m5-cloudbase-collections.mjs",
    "m5:backfill:conversations": "node scripts/backfill-conversation-indexes.mjs",
    "m5:flow": "vitest run m5-server-flow-and-load",
    "m5:http:flow": "node scripts/m5-http-flow-and-load.mjs",
    "m5:http:load": "node scripts/m5-http-flow-and-load.mjs --load",
    "m5:hosted:verify": "node scripts/m5-hosted-verify.mjs",
    "m5:load": "vitest run m5-server-flow-and-load",
    "lint": "eslint . --max-warnings=0",
    "production:ops:baseline": "node scripts/production-ops-baseline-check.mjs",
    "release:production:preflight": "node scripts/production-readiness-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
