# Local or isolated M5 test environment example.
# Copy to .env.local for local development, then replace placeholders locally.
# Never commit .env.local or real secrets.
APP_ENV=test
CLOUDBASE_ENV_ID=ungradu-edu-test-d0ed1mqeceb0ae1
AUTH_SESSION_SECRET=replace-with-a-long-random-server-session-secret
TENCENTCLOUD_SECRETID=your-secret-id
TENCENTCLOUD_SECRETKEY=your-secret-key
M5_ENABLE_HOSTED_TEST_LOGIN=false

# Email verification login provider placeholders.
# Keep EMAIL_CODE_SECRET server-only. Production may reuse AUTH_SESSION_SECRET
# only if the project controller explicitly accepts that key rotation behavior.
EMAIL_CODE_SECRET=replace-with-a-long-random-email-code-hash-secret
EMAIL_PROVIDER=console
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password-or-app-token
EMAIL_FROM=replace-with-from-email

# Password login uses server-side scrypt with a unique per-password salt.
# Do not commit plaintext passwords, password hashes, or any real secrets.

# Formal production / small-scale production trial must use a separate
# CloudBase environment and production-only secrets configured in the
# deployment console, not in Git.
#
# APP_ENV=production
# CLOUDBASE_ENV_ID=your-production-cloudbase-env-id
# AUTH_SESSION_SECRET=replace-in-console-with-production-strong-random-secret
# TENCENTCLOUD_SECRETID=replace-in-console-with-production-secret-id
# TENCENTCLOUD_SECRETKEY=replace-in-console-with-production-secret-key
# EMAIL_CODE_SECRET=replace-in-console-with-production-email-code-hash-secret
# EMAIL_PROVIDER=smtp
# SMTP_HOST=replace-in-console-with-smtp-host
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace-in-console-with-smtp-user
# SMTP_PASS=replace-in-console-with-smtp-password-or-app-token
# EMAIL_FROM=replace-in-console-with-from-email
#
# Do not set these in production:
# M5_ENABLE_HOSTED_TEST_LOGIN=true
# NEXT_PUBLIC_ALLOW_TEST_LOGIN=true

# Optional public Dify WebApp URL for the in-site customer service page.
# This is a public embed URL, not an API key. Leave empty to use the built-in
# server-side customer service proxy.
NEXT_PUBLIC_DIFY_CUSTOMER_SERVICE_URL=

# Customer service runtime mode:
# - local_mvp: use the built-in local guarded KB path and local intake/audit files.
# - dify: require server-side Dify configuration and fail closed when missing.
CUSTOMER_SERVICE_RUNTIME_MODE=local_mvp

# Persistence defaults to local files outside production and CloudBase
# collections when APP_ENV=production. Set file only for local troubleshooting.
CUSTOMER_SERVICE_PERSISTENCE_MODE=

# Local customer service data root. Keep these server-only and outside any
# public static directory. The defaults under Code文档/data/customer-service/
# are suitable for local MVP only.
CUSTOMER_SERVICE_DATA_DIR=
CUSTOMER_SERVICE_AUDIT_JSONL_PATH=
CUSTOMER_SERVICE_INTAKE_JSONL_PATH=
CUSTOMER_SERVICE_STATE_PATH=

# Server-side Dify integration placeholders. Never expose these to the client.
DIFY_BASE_URL=
DIFY_APP_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_APP_ID=
DIFY_DATASET_ID=
DIFY_FALLBACK_MODEL=
DIFY_SELF_REVIEW_MODEL=
DIFY_REQUEST_TIMEOUT_MS=15000

# CloudBase origin isolation. Keep off until the approved observation window.
# Store the real secret only in the Cloudflare Worker and CloudBase platform
# secret stores. Both platforms must use the same value.
ORIGIN_VERIFY_MODE=off
ORIGIN_VERIFY_SECRET=replace-in-platform-secret-store-only
